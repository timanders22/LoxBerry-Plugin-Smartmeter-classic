SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
MAILTO=""
#
# m h dom mon dow user command1
# vzLogger mode: poll local vzlogger API and forward readings to the Miniserver.
# fetch_vzlogger.pl exits immediately if the vzLogger mode is disabled.
* * * * * loxberry REPLACELBHOMEDIR/bin/plugins/REPLACELBPPLUGINDIR/fetch_vzlogger.pl >/dev/null 2>&1
#
# Die Verbrauchshistorie je Stunde. Sie liest NUR, was einer der beiden
# Leser auf der Ramdisk hinterlegt hat, und redet mit keinem Geraet -
# deshalb laeuft sie in beiden Betriebsarten und schadet in keiner.
#
# Im selben Minutentakt wie der Leser darueber, ohne Versatz: cron kennt
# keine Sekunden (fuenf Zeitfelder, das kleinste ist die Minute), und ein
# Versatz waere auch nicht noetig - beide Leser schreiben ihre Datendatei
# ueber temp + rename, eine halb geschriebene kann hier also nicht
# ankommen. Die Differenz wird ohnehin ueber den Zeitstempel IN der Datei
# gebildet und nicht ueber den Zeitpunkt des Lesens; ein Lauf ohne neue
# Messung erkennt das und tut nichts.
* * * * * loxberry REPLACELBHOMEDIR/bin/plugins/REPLACELBPPLUGINDIR/sm_historie.php >/dev/null 2>&1
#
# Der Fahrplan-Abgleich (2.7.0). Er bricht sofort ab, solange
# ABGLEICH.AKTIV nicht auf 1 steht - ab Werk tut er also nichts.
#
# Fuenf Minuten, nicht eine: er fragt eine FREMDE Adresse ab (den JSON-
# Endpunkt des oertlichen Spotpreis-Plugins), und dessen Fahrplan aendert
# sich stuendlich. Ein Minutentakt brachte nichts und belastete den
# Nachbarn sechzigmal so oft. Die Laufzeit einer Regel wird trotzdem auf
# die Sekunde gerechnet - gemessen wird ueber die Zeitstempel IN den
# Datendateien, nicht ueber den Zeitpunkt des Laufs.
*/5 * * * * loxberry REPLACELBHOMEDIR/bin/plugins/REPLACELBPPLUGINDIR/sm_abgleich.php >/dev/null 2>&1
