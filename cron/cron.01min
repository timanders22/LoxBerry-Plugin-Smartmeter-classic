#!/bin/sh
# Smartmeter classic - Minutentakt.
#
# WARUM DIESE DATEI SEIT 2.7.1 EXISTIERT
#
# Bis 2.7.0 lieferte diese Linie ihre Auftraege als cron/crontab aus. Am
# Quelltext des Installateurs gemessen (sbin/plugininstall.pl, frischer Klon):
#
#   :989   if (-e "$tempfolder/cron/crontab"
#             && !-e "$lbhomedir/system/cron/cron.d/$pname") { cp ... }
#   :1571  if ($option eq "all") { rm -vf .../cron/cron.d/$pname }
#          # Kommentar dort: "Delete individual crontab file (only on uninstall)"
#
# Zusammen heisst das: die Datei wird NUR angelegt, wenn sie noch nicht da
# ist, und nur beim DEINSTALLIEREN entfernt. Auf einer bestehenden Anlage
# erreicht eine Aenderung an cron/crontab also nie an - sie wirkt allein bei
# einer Neuinstallation. Die Ordner cron.NNmin/ verhalten sich umgekehrt: sie
# werden beim Upgrade entfernt (:1566) und frisch kopiert (:1000).
#
# ZWEI AUFTRAEGE, NEBENLAEUFIG - UND WARUM
#
# In der alten crontab standen fetch_vzlogger.pl und sm_historie.php als ZWEI
# Zeilen. cron startet zwei Zeilen derselben Minute nebenlaeufig; haengt die
# eine, laeuft die andere trotzdem. Ein Skript, das beide nacheinander
# aufruft, haette genau das aufgegeben - ein haengender Leser haette die
# Historie mit angehalten. Deshalb stehen sie hier im Hintergrund mit
# abschliessendem 'wait': das bildet die alte Lage nach, statt sie
# stillschweigend zu verschaerfen.
#
# FEHLERAUSGABE
#
# Die alte crontab schrieb '>/dev/null 2>&1' - auch Fehlermeldungen. Hier geht
# die normale Ausgabe weiter ins Nichts (im Regelfall schweigen beide), die
# FEHLERausgabe aber ins Systemprotokoll. Dieselbe Bauart wie bei
# BatterieBMS und Abfahrts-Assistent.
#
# Den bin-Pfad des Plugins setzt der Installer in der Zeile darunter ein (plugininstall.pl:1854).
BIN="REPLACELBPBINDIR"

if [ ! -d "$BIN" ]; then
    logger -t smartmeter-classic "bin-Ordner nicht gefunden: $BIN"
    exit 1
fi

# Gruppe 35 (2.8.13; Bauart Spotpreis aWATTar 1.2.39): ruft jemand diese Datei als root auf, laeuft sie als
# loxberry weiter - sonst legten die Laeufe root-eigene Dateien an (der LoxBerry-Cron startet ohnehin als
# loxberry; der Zweig ist eine Haertung).
if [ "$(id -u)" = "0" ] && command -v su >/dev/null 2>&1 && [ -z "${SM_ALS_LOXBERRY:-}" ]; then
    SM_ALS_LOXBERRY=1 exec su loxberry -s /bin/sh -c "SM_ALS_LOXBERRY=1 /bin/sh '$0'"
fi

# vzLogger: bricht selbst sofort ab, wenn die Betriebsart nicht vzLogger ist.
if [ -x "$BIN/fetch_vzlogger.pl" ]; then
    ( "$BIN/fetch_vzlogger.pl" 2>&1 >/dev/null | logger -t smartmeter-classic ) &
else
    logger -t smartmeter-classic "fetch_vzlogger.pl fehlt oder ist nicht ausfuehrbar"
fi

# Verbrauchshistorie: liest nur, was ein Leser auf der Ramdisk hinterlegt hat,
# und redet mit keinem Geraet - laeuft deshalb in beiden Betriebsarten.
if [ -x "$BIN/sm_historie.php" ]; then
    ( "$BIN/sm_historie.php" 2>&1 >/dev/null | logger -t smartmeter-classic ) &
else
    logger -t smartmeter-classic "sm_historie.php fehlt oder ist nicht ausfuehrbar"
fi

# Gruppe 35 (2.8.13, Entscheidung 5): der Abnehmer haus/speicher - ein abgekoppelter Leser, der bis
# 65 s auf ein LIVE-Lebenszeichen des Anbieters wartet. Er laeuft DOPPELT abgekoppelt (die aeussere
# Unterschale endet sofort), damit das "wait" darunter nie auf ihn wartet; Deskriptoren 8 und 9 zu
# (Gedaechtnis sperre-vererbt-sich-an-kinder). Ob er etwas tut (Haken SPEICHER_EIN, eine Regel aktiv,
# keine Upgrade-Marke) und dass hoechstens einer laeuft (haus.lock), entscheidet sm_abgleich.php selbst.
if [ -x "$BIN/sm_abgleich.php" ]; then
    ( ( "$BIN/sm_abgleich.php" --haus-lesen 2>&1 >/dev/null </dev/null | logger -t smartmeter-classic ) 8<&- 9<&- & )
fi

wait
exit 0
